PORT=3001
NODE_ENV=development

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

CONDUIT_REPO_PATH=
CORS_ORIGIN=http://localhost:5173

# Git / GitHub 认证（用于真实 PR 创建 + clone/push 私有仓库）
GIT_USER_NAME=
GIT_USER_EMAIL=
# GitHub fine-grained token，权限: contents read/write + pull requests read/write
GITHUB_TOKEN=
# 备选：通用 Git auth token（与 GITHUB_TOKEN 二选一即可）
# GIT_AUTH_TOKEN=
GITHUB_BASE_BRANCH=main
GITHUB_REMOTE=origin
# 无法从 remote URL 自动推断时手动配置
# GITHUB_OWNER=
# GITHUB_REPO=
